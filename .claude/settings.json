{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "$s = \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\roadmap-au-demarrage.ps1\"; if (Test-Path $s) { & $s }",
            "timeout": 15,
            "statusMessage": "Lecture de la feuille de route..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/wgsl-backtick-guard.mjs",
            "timeout": 20,
            "statusMessage": "Garde backtick WGSL"
          }
        ]
      }
    ]
  }
}
