{
  "name": "shaderlab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri dev": "tauri dev",
    "tauri build": "tauri build",
    "dev:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:debug:follow": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -Follow",
    "dev:monitor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/monitor.ps1",
    "test": "vitest run --project=unit",
    "test-storybook": "vitest run --project=storybook",
    "test-storybook:watch": "vitest --project=storybook",
    "test:all": "vitest run",
    "coverage": "vitest run --project=storybook --coverage",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:gpu-shaders": "node scripts/gpu-shader-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-vitest": "^10.5.3",
    "@storybook/react-vite": "^10.5.2",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "playwright": "^1.61.1",
    "shadcn": "^4.13.1",
    "storybook": "^10.5.2",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
